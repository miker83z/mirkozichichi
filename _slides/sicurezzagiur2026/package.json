{
  "name": "sicurezzagiur2026",
  "private": true,
  "type": "module",
  "description": "Introduzione alla Crittografia (sulla sicurezza ed altre amenità informatiche): slide interattive, edizione novembre 2026",
  "scripts": {
    "dev": "slidev slides.md --open",
    "build": "slidev build slides.md --base /slides/sicurezzagiur2026/ --out ../../slides/sicurezzagiur2026",
    "pdf": "slidev export dispensa.md --output ../../assets/tutor/slides/sicurezzagiur2026.pdf --timeout 120000 --wait 300",
    "pdf:slides": "slidev export slides.md --output ../../assets/tutor/slides/sicurezzagiur2026-slides.pdf --timeout 120000 --wait 300",
    "check-links": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/literata": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.2.9",
    "@slidev/cli": "53.0.0",
    "@slidev/theme-default": "0.25.0",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "playwright-chromium": "1.64.1",
    "qrcode": "1.5.4"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "image-size": "2.0.4"
  }
}
