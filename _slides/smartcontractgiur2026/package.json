{
  "name": "smartcontractgiur2026",
  "private": true,
  "type": "module",
  "description": "Blockchain & Smart Contracts: slide interattive, edizione novembre 2026",
  "scripts": {
    "dev": "slidev slides.md --open",
    "build": "rm -rf ../../slides/smartcontractgiur2026 && slidev build slides.md --base /slides/smartcontractgiur2026/ --out ../../slides/smartcontractgiur2026 && npm run aula:build",
    "pdf": "slidev export dispensa.md --output ../../assets/tutor/slides/smartcontractgiur2026.pdf --timeout 120000 --wait 300",
    "pdf:slides": "slidev export slides.md --output ../../assets/tutor/slides/smartcontractgiur2026-slides.pdf --timeout 120000 --wait 300",
    "check-links": "node scripts/check-links.mjs",
    "aula:dev": "vite --config aula/app/vite.config.ts",
    "aula:build": "vite build --config aula/app/vite.config.ts",
    "aula:test": "cd aula/move && iota move test"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/montserrat": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.2.9",
    "@iota/iota-sdk": "1.17.0",
    "@slidev/cli": "53.0.0",
    "@slidev/theme-default": "0.25.0",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "playwright-chromium": "1.64.1",
    "qrcode": "1.5.4"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "image-size": "2.0.4"
  }
}
